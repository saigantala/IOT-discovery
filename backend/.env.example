# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@127.0.0.1:5432/secureiot

# Server Port
PORT=4000

# JWT Security Secrets (Use random 32+ char strings in production)
JWT_ACCESS_SECRET=your_super_secret_access_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key

# Optional MQTT Integration Flag (Set to false to disable MQTT broker connections)
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://localhost:1883

# Machine Learning Sidecar Service URL
ML_SERVICE_URL=http://localhost:5005
